{
  "name": "db-restore",
  "version": "1.2.2",
  "description": "Database backup & restore for local development",
  "license": "MIT",
  "author": {
    "name": "Martín M.",
    "url": "https://github.com/skydiver/"
  },
  "type": "module",
  "bin": {
    "db-restore": "./build/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf build",
    "dev": "tsx watch src/cli.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "docker compose -f docker-compose.test.yml up -d --wait && PGPORT=5433 MYSQL_PORT=3307 vitest run; status=$?; docker compose -f docker-compose.test.yml down -v; exit $status",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@tsconfig/node24": "^24.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "volta": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "better-sqlite3": "^13.0.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "mysql2": "^3.23.1",
    "ora": "^9.4.1",
    "pg": "^8.22.0"
  }
}
